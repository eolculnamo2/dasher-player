{
  "name": "dasher-effect",
  "sideEffects": false,
  "private": true,
  "type": "module",
  "module": "main.ts",
  "scripts": {
    "start": "bun run ./src/main.ts",
    "build": "bun build ./src/main.ts --outdir ./build --target browser",
    "build:prod": "bun build ./src/main.ts --outdir ./build --minify --target browser --sourcemap=none",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@effect/platform": "^0.96.1",
    "effect": "^3.21.2",
    "mpd-parser": "^1.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.47.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
